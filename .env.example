# Copy file này thành .env rồi điền giá trị thật. KHÔNG chia sẻ / commit file .env.

# Cổng chạy server
PORT=3000
# Địa chỉ HTTPS public trỏ về server (Cloudflare Tunnel khi dev, tên miền thật khi chạy VPS)
PUBLIC_URL=https://ten-mien-cua-ban.vn

# --- Zalo (lấy tại https://developers.zalo.me > ứng dụng của bạn) ---
ZALO_APP_ID=
ZALO_APP_SECRET=
# "OA Secret Key" ở mục Webhook của ứng dụng – dùng để kiểm tra chữ ký webhook
ZALO_OA_SECRET_KEY=
# (Tuỳ chọn) refresh token lấy từ API Explorer, chỉ dùng lần chạy đầu nếu chưa bấm "Kết nối Zalo OA" trong trang admin
ZALO_REFRESH_TOKEN=
# Mã xác thực tên miền Zalo (mục Xác thực domain > thẻ meta)
ZALO_SITE_VERIFICATION=

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Trang quản trị /admin (mật khẩu đăng nhập tại /login; đổi mật khẩu là mọi phiên cũ bị đăng xuất) ---
ADMIN_PASSWORD=doi-mat-khau-nay

# Bot chuyển nhân viên mà sau bấy nhiêu phút chưa có nhân viên trả lời thì bot tự nhận lại khách
HANDOVER_MINUTES=10

# Gửi tin theo SĐT (ZBS). Đặt 1 để hiện lại khi đã có mẫu tin được Zalo duyệt.
ZNS_ENABLED=
